# Copy these into your shell / IDE run configuration. Placeholders only - never commit real values.
DB_URL=jdbc:mysql://localhost:3306/busgo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=busgo_user
DB_PASSWORD=change_me
# At least 32 characters; used to sign login tokens
JWT_SECRET=replace_with_a_long_random_string_of_32_plus_chars
# Optional: Google sign-in. The OAuth *Web* client id from Google Cloud Console (a client id is public; never put a client secret anywhere).
# Leave empty to keep Google sign-in disabled. See docs/GOOGLE_SIGN_IN_SETUP.md
GOOGLE_CLIENT_IDS=
# Optional: real emails (reset codes, welcome, booking confirmation). See docs/EMAIL_SETUP.md
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
