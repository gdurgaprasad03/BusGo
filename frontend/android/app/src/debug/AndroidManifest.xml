<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY: allow plain http:// so the app can reach the local backend
         (10.0.2.2 on the emulator, or your PC's LAN IP on a phone). Release builds do not
         include this file, so they keep Android's default of blocking cleartext traffic. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
